{
  "name": "scribe-widget",
  "version": "1.0.17",
  "description": "Floating panel widget for medical transcription using eka.scribe",
  "main": "dist/scribe-widget.umd.js",
  "module": "dist/scribe-widget.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:extension": "vite build && node scripts/build-extension.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "med-scribe-alliance-ts-sdk": "1.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.0"
  }
}
