{
  "manifest_version": 3,
  "name": "Eka Scribe",
  "description": "Medical transcription widget powered by Eka Care",
  "version": "1.0.0",
  "action": {
    "default_title": "Open Eka Scribe"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["scribe-widget.js", "scribe-widget.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
